        always {

            deleteDir()
        }
    }
}


// =================================================================
// FUNCTION 1 - BUILD AND PUSH
// =================================================================

def buildAndPush(String APP_IMAGE, String BUILD_CONTEXT) {

    def image = docker.build(
        "${env.ECR_REGISTRY}/${APP_IMAGE}:${env.GIT_COMMIT}",
        "${BUILD_CONTEXT}"
    )

    docker.withRegistry(
        "${env.ECR_REGISTRY_URL}",
        "ecr:${env.AWS_REGION}:${env.AWS_CREDENTIALS}"
    ) {

        image.push()
    }
}


// =================================================================
// FUNCTION 2 - PROMOTE IMAGE
// =================================================================

def promoteImage(String sourceImage, String targetImage) {

    // =============================================================
    // Pull source image from ECR
    // =============================================================

    docker.withRegistry(
        "${env.ECR_REGISTRY_URL}",
        "ecr:${env.AWS_REGION}:${env.AWS_CREDENTIALS}"
    ) {

        docker.image(
            "${env.ECR_REGISTRY}/${sourceImage}:${env.GIT_COMMIT}"
        ).pull()
    }


    // =============================================================
    // Tag source image with target environment
    // =============================================================

    sh """
        docker tag \\
        ${env.ECR_REGISTRY}/${sourceImage}:${env.GIT_COMMIT} \\
        ${env.ECR_REGISTRY}/${targetImage}:${env.GIT_COMMIT}
    """


    // =============================================================
    // Push target image to ECR
    // =============================================================

    docker.withRegistry(
        "${env.ECR_REGISTRY_URL}",
        "ecr:${env.AWS_REGION}:${env.AWS_CREDENTIALS}"
    ) {

        docker.image(
            "${env.ECR_REGISTRY}/${targetImage}:${env.GIT_COMMIT}"
        ).push()
    }
}


