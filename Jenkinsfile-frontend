        // App-1 images
        // =========================================================

        APP_IMAGE_DEV  = 'app-4-frontend-dev'
        APP_IMAGE_QA   = 'app-4-frontend-qa'
        APP_IMAGE_UAT  = 'app-4-frontend-uat'
        APP_IMAGE_PROD = 'app-4-frontend-prod'

        // AWS credentials
        AWS_CREDENTIALS = 'aws-credentials'

        // Docker build context
        BUILD_CONTEXT    = './frontend'
        PROXY_DOCKERFILE = './frontend/Dockerfile'
    }

    parameters {

        choice(
            name: 'Environment',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select the deployment environment'
        )
    }

    stages {

        // =========================================================
        // DEV
        // =========================================================

        stage('Dev - Build & Push') {

            when {
                expression {
                    params.Environment == 'dev'
                }
            }

            steps {

                script {

                    buildAndPush(
                        "${env.APP_IMAGE_DEV}",
                        "${env.BUILD_CONTEXT}"
                    )
                }
            }
        }

        // =========================================================
        // QA
        // =========================================================

        stage('Promote Dev to QA') {
            when {
                expression {
                    params.Environment == 'qa'
                }
            }

            steps {

                script {

                    promoteImage(
                        "${env.APP_IMAGE_DEV}",
                        "${env.APP_IMAGE_QA}"
                    )
                }
            }
        }

        // =========================================================
        // UAT
        // =========================================================

        stage('Promote QA to UAT') {
            when {
                expression {
                    params.Environment == 'uat'
                }
            }

            steps {

                script {

                    promoteImage(
                        "${env.APP_IMAGE_QA}",
                        "${env.APP_IMAGE_UAT}"
                    )
                }
            }
        }

        // =========================================================
        // PROD APPROVAL
        // =========================================================

        stage('Approval for Prod Deployment') {

            when {
                expression {
                    params.Environment == 'prod'
                }
            }

            steps {

                input(
                    message: 'Promote UAT image to PROD?',
                    ok: 'Proceed'
                )
            }
        }

        // =========================================================
        // PROD
        // =========================================================

        stage('Promote UAT to PROD') {
            when {
                expression {
                    params.Environment == 'prod'
                }
            }

            steps {

                script {

                    promoteImage(
                        "${env.APP_IMAGE_UAT}",
                        "${env.APP_IMAGE_PROD}"
                    )
                }
            }
        }

        // =========================================================
        // DEPLOY FRONTEND
        // =========================================================
